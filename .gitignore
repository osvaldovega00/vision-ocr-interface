# .gitignore for Vision-Based OCR Reading System
# Prevents build artifacts, IDE settings, logs, and sensitive config files from being tracked

# Build output
bin/
obj/
*.exe
*.dll
*.pdb

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# IDE settings
.vscode/
*.vs/

# Logs and temp files
*.log
*.tmp
Logs/
*.bak

# Real config file (machine-specific)
OCR Vision Reading Settings.xml

# OS-specific files
.DS_Store
Thumbs.db

# Git metadata
*.orig
*.swp
